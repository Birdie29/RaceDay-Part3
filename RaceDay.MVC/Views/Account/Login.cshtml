@model RaceDay.MVC.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
    var role = ViewBag.Role as string;
}

<div class="container mt-5">
  <div class="row justify-vontent-center">
     <div class="col-md-6">
     <h2 class="text-center mb-4">
        Login as @role
        </h2>

        @if (TempData["AccountNotice"] is string notice)
        {
          <div class="alert alert-info" role="alert">@notice</div>
        }

        <form method="post" asp-action="Login">
        @Html.AntiForgeryToken()
        <input asp-for="Role" type="hidden" value="@role"/>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
        <label class="form-label">EmailAddress</label>
        <input asp-for="Email" type="email" class="form-control" required/>
        </div>

        <div class="mb-3">
        <label class="form-label">Password</label>
        <input asp-for="Password" type="password" class="form-control" required/>
        </div>

        <button type="submit" class="btn btn-primary w-100">
        Login</button>

        </form>
        <p class="mt-3">
          Need an account?
          <a asp-action="Register" asp-route-role="@role">Register</a>
        </p>
        </div>
        </div>
        </div>