@model RaceDay.MVC.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
    var role = ViewBag.Role as string;
}

<div class="account-page">
    <section class="account-card" aria-labelledby="account-title">
        <a asp-controller="Home" asp-action="Index" class="account-brand">
            <span class="account-brand-mark" aria-hidden="true">
                <i class="bi bi-flag-fill"></i>
            </span>
            <span>Race<span class="account-brand-light">Day</span></span>
        </a>

        <p class="account-eyebrow">@role Portal</p>
        <h1 id="account-title">Welcome back</h1>
        <p class="account-intro">Log in to continue to your @role dashboard.</p>

        @if (TempData["AccountNotice"] is string notice)
        {
            <div class="account-notice" role="status">@notice</div>
        }

        <form method="post" asp-action="Login" class="account-form">
            @Html.AntiForgeryToken()
            <input asp-for="Role" type="hidden" value="@role" />
            <div asp-validation-summary="ModelOnly" class="account-validation" role="alert"></div>

            <div class="account-field">
                <label asp-for="Email" class="form-label">Email address</label>
                <input asp-for="Email"
                       type="email"
                       class="form-control"
                       autocomplete="email"
                       placeholder="you@example.com"
                       required />
            </div>

            <div class="account-field">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password"
                       type="password"
                       class="form-control"
                       autocomplete="current-password"
                       placeholder="Enter your password"
                       required />
            </div>

            <button type="submit" class="account-submit">Log in</button>
        </form>

        <p class="account-switch">
            Need an account?
            <a asp-action="Register" asp-route-role="@role">Register</a>
        </p>
    </section>
</div>
