@model RaceDay.MVC.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    var role = ViewBag.Role as string;
}

<div class="account-page account-page--register">
    <section class="account-card account-card--register" aria-labelledby="account-title">
        <a asp-controller="Home" asp-action="Index" class="account-brand">
            <span class="account-brand-mark" aria-hidden="true">
                <i class="bi bi-flag-fill"></i>
            </span>
            <span>Race<span class="account-brand-light">Day</span></span>
        </a>

        <p class="account-eyebrow">@role Portal</p>
        <h1 id="account-title">Create your account</h1>
        <p class="account-intro">Register as an @role to get started with RaceDay.</p>

        <form method="post" asp-action="Register" class="account-form">
            @Html.AntiForgeryToken()
            <input asp-for="Role" type="hidden" value="@role" />
            <div asp-validation-summary="ModelOnly" class="account-validation" role="alert"></div>

            <div class="account-field">
                <label asp-for="Name" class="form-label">First name</label>
                <input asp-for="Name"
                       type="text"
                       class="form-control"
                       autocomplete="given-name"
                       placeholder="Your first name"
                       required />
            </div>

            <div class="account-field">
                <label asp-for="Surname" class="form-label">Surname</label>
                <input asp-for="Surname"
                       type="text"
                       class="form-control"
                       autocomplete="family-name"
                       placeholder="Your surname"
                       required />
            </div>

            <div class="account-field">
                <label asp-for="Email" class="form-label">Email address</label>
                <input asp-for="Email"
                       type="email"
                       class="form-control"
                       autocomplete="email"
                       placeholder="you@example.com"
                       required />
            </div>

            <div class="account-field">
                <label asp-for="PhoneNumber" class="form-label">Phone number</label>
                <input asp-for="PhoneNumber"
                       type="tel"
                       class="form-control"
                       autocomplete="tel"
                       placeholder="Your phone number"
                       required />
            </div>

            <div class="account-field">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password"
                       type="password"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="Create a password"
                       required />
            </div>

            <button type="submit" class="account-submit">Create account</button>
        </form>

        <p class="account-switch">
            Already registered?
            <a asp-action="Login" asp-route-role="@role">Log in</a>
        </p>
    </section>
</div>
