@model RaceDay.MVC.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    var role = ViewBag.Role as string;
}

<div class="container mt-5">
 <div class="row justify-content-center"> 
    <div class="col-md-6">
       <h2 class="text-center mb-4">
       Register as @role
       </h2>

       <form method="post" asp-action="Register">
         @Html.AntiForgeryToken()
         <input asp-for="Role" type="hidden" value="@role" />
         <div asp-validation-summary="ModelOnly" class="text-danger"></div>

         <div class="mb-3">
           <label class="form-label">Name</label>
           <input asp-for="Name" type="text" class="form-control" required/>
           </div>

           <div class="mb-3">
           <label class="form-label">Surname</label>
           <input asp-for="Surname" type="text" class="form-control" required/>
           </div>

           <div class="mb-3">
           <label class="form-label"> EmailAddress</label>
           <input asp-for="Email" type="email" class="form-control" required/>
           </div>

           <div class="mb-3">
           <label class="form-label">PhoneNumber</label>
           <input asp-for="PhoneNumber" type="tel" class="form-control" required/>
           </div>

           <div class="mb-3">
           <label class="form-label">Password</label>
           <input asp-for="Password" type="password" class="form-control" required/>
           </div>

           <button type="submit" class="btn btn-primary w-100">
           Register</button>
           </form>
           <p class="mt-3">
             Already registered?
             <a asp-action="Login" asp-route-role="@role">Log in</a>
           </p>
           </div>
           </div>
           </div>