@{
    ViewData["Title"] = "Organiser Dashboard";
    Layout = "_Layout";
}

<div class="race-dashboard">
<!--sidebar-->
<aside class="race-sidebar">
  <div class="brand">
  <span class="brand-icon"></span>
  <span>Race<span class="brand-light">Day</span>
  </span>
  </div>

  <p class="sidebar-label">MAIN MENU</p>
  <a href="#" class="side-link active">
  <span></span> Dashboard</a>

  <a href="#" class="side-link">
  <span></span> Manage Events</a>
  <a href="#" class="side-link">
  <span></span>
  Categories</a>

  <a href="#" class="side-link">
  <span></span>
  Enrollments</a>
  <a href="#" class="side-link">
  <span></span> Race Results</a>

  <div class="sidebar-bottom">
  <p class="sidebar-label">ACCOUNT</p>
  <a href="#" class="side-link">
  <span>radio icon</span>
  Settings
  </a>
  <a asp-controller="Account" asp-action="Login" class="side-link">
  <span>arrow</span>
  Logout
  </a>
  </div>
  </aside>

  <main class="dashboard-main">
    <header class="dashboard-header">

    <div>
    <p class="welcome-label">ORGANISER PORTAL</p>
    <h1>Dashboard</h1>
    <p class="welcome-text">
    Welcome back! Heres whta's happening with your events.
    </p>
    </div>
    
    <div class="header-date">
    <span>calendar</span>
    @DateTime.Now.ToString("dddd, dd MMMM yyyy")
    </div>
    </header>

    <section class="stats-grid">
     <div class="stat-card">
     <div class="stat-top">
     <span>Total Events</span>
     <span class="stat-icon green-icon">flag</span>
     </div>

     <h2>@ViewBag.TotalEvents</h2>
     <p>Events created</p>
     </div>

     <div class="stat-card">
     <div class="stat-top">
     <span> Total Enrollments</span>

     <span class="stat-icon light-icon"></span>
     </div>

     <h2>@ViewBag.TotalEnrolments</h2>
     <p>Registered participants</p>
     </div>

     <div class="stat-card">
     <div class="stat-top">
     <span>Upcoming Events</span>

     <span class="stat-icon yellow-icon"></span>
     </div>

     <h2>@ViewBag.UpcomingEvents</h2>
     <p>Events coming soon</p>
     </div>

     <div class="stat-card">
     <div class="stat-top">

     <span>Completed Events</span>
     <span class="stat-icon dark-icon"></span>
     </div>

     <h2>@ViewBag.CompletedEvents</h2>
     <p>Successfully completed</p>
     </div>
     </section>

     <section class="quick-section">
     <div class="section-heading">

     <div>
     <h3>Quick Actions</h3>
     <p>Manage your race events easily.</p>
     </div>
     </div>

     <div class="quick-grid">
     <a href="#" class="quick-card">
     <span class="quick-icon">+</span>

     <div>
     <h4>Create Event<h4>
     <p>Add a new race event</p>
     </div>
     </a>

     <a href="#" class="quick-card">
     <span cass="quick-icon"></span>
     <div>
     <h4>Manage Categories</h4>
     <p>Set up race categories</p>
     </div>
     </a>

     <a href="#" class="quick-card">
     <span class="quick-icon"></span>

     <div>
     <h4>View Enrollments</h4>
     <p>Check registered runners</p>
     </div>
     </a>

     <a href="#" class="quick-card">
     <span class="quick-icon"></span>

     <div>
     <h4>Enter Results</h4>
     <p>Publish race results</p>
     </div>
     </a>
     </div>
     </section>

     <section class="events-section">
     <div class="section-heading">
     <div>
     <h3>Upcoming Events</h3>
     <p>Keep track of your next scheduled races.</p>
     </div>

     <a href="#" class="view-all">View All Events</a>

     </div>

     <div class="table-responsive">
     <table class="table events-table">
     <thead>
     <tr>
     <th>EVENT NAME</th>
     <th>DATE</th>
     <th>LOCATION</th>
     <th>DISTANCE</th>
     <th>ENROLMENTS</th>
     <th>STATUS</th>
     </tr>
     </thead>

     <body>@foreach(var race in ViewBag.Events)
     {
        <tr>
        <td class="event-name">
        @race.name
        </td>

        <td>@Grace.Date.ToString("dd MMM yyyy")</td>

        <td>@race.Location</td>

        <td>@race.Distance</td>

        <td>

        <span class="enrolment-count">

        @race.ENROLMENTS

        </span>
        </td>

        <td>
        <span class="status-upcoming">

        @race.status
        </span>
        </td>

        </tr>
     }
     </tbody>
     </table>
     </div>
     </section>

     <footer class="dashboard-footer">
     & @DateTime.Now.Year
     RaceDay. All rights reserved.
     Keep moving. Keep racing.
     </footer>

     </main>
     </div>
  