@{
    ViewData["Title"] = "Organiser Dashboard";
    Layout = "_Layout";
}

<div class="race-dashboard">
    <partial name="_Sidebar" />

    <div class="dashboard-main">
        @if (ViewBag.ApiError is string apiError)
        {
            <div class="alert alert-warning" role="alert">@apiError</div>
        }
        @if (TempData["WorkspaceMessage"] is string successMessage)
        {
            <div class="alert alert-success" role="status">@successMessage</div>
        }
        @if (TempData["WorkspaceError"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }
        <header class="dashboard-header">
            <div>
                <p class="welcome-label">ORGANISER PORTAL</p>
                <h1>Welcome, @ViewBag.UserName</h1>
                <p class="welcome-text">Welcome back! Here’s what’s happening with your events.</p>
            </div>

            <div class="header-date">
                <i class="bi bi-calendar3" aria-hidden="true"></i>
                @DateTime.Now.ToString("dddd, dd MMMM yyyy")
            </div>
        </header>

        <section class="stats-grid">
            <div class="stat-card">
                <div class="stat-top">
                    <span>Total Events</span>
                    <span class="stat-icon green-icon"><i class="bi bi-flag-fill" aria-hidden="true"></i></span>
                </div>
                <h2>@ViewBag.TotalEvents</h2>
                <p>Events created</p>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <span>Total Enrollments</span>
                    <span class="stat-icon light-icon"></span>
                </div>
                <h2>@ViewBag.TotalEnrolments</h2>
                <p>Registered participants</p>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <span>Upcoming Events</span>
                    <span class="stat-icon yellow-icon"></span>
                </div>
                <h2>@ViewBag.UpcomingEvents</h2>
                <p>Events coming soon</p>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <span>Completed Events</span>
                    <span class="stat-icon dark-icon"></span>
                </div>
                <h2>@ViewBag.CompletedEvents</h2>
                <p>Successfully completed</p>
            </div>
        </section>

        <section class="quick-section">
            <div class="section-heading">
                <div>
                    <h3>Quick Actions</h3>
                    <p>Manage your race events easily.</p>
                </div>
            </div>

            <div class="quick-grid">
                <a asp-action="CreateEvent" class="quick-card">
                    <span class="quick-icon"><i class="bi bi-plus-lg" aria-hidden="true"></i></span>
                    <div>
                        <h4>Create Event</h4>
                        <p>Add a new race event</p>
                    </div>
                </a>

                <a asp-action="Categories" class="quick-card">
                    <span class="quick-icon"><i class="bi bi-tags" aria-hidden="true"></i></span>
                    <div>
                        <h4>Manage Categories</h4>
                        <p>Set up race categories</p>
                    </div>
                </a>

                <a asp-action="Registrations" class="quick-card">
                    <span class="quick-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
                    <div>
                        <h4>View Enrollments</h4>
                        <p>Check registered runners</p>
                    </div>
                </a>

                <a asp-action="Results" class="quick-card">
                    <span class="quick-icon"><i class="bi bi-trophy" aria-hidden="true"></i></span>
                    <div>
                        <h4>Enter Results</h4>
                        <p>Publish race results</p>
                    </div>
                </a>
            </div>
        </section>

        <section class="events-section">
            <div class="section-heading">
                <div>
                    <h3>Upcoming Events</h3>
                    <p>Keep track of your next scheduled races.</p>
                </div>
                <a asp-action="Events" class="view-all">View All Events</a>
            </div>

            <div class="table-responsive">
                <table class="table events-table">
                    <thead>
                        <tr>
                            <th>EVENT NAME</th>
                            <th>DATE</th>
                            <th>LOCATION</th>
                            <th>DISTANCE</th>
                            <th>ENROLMENTS</th>
                            <th>STATUS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var race in ViewBag.Events)
                        {
                            <tr>
                                <td class="event-name">@race.EventName</td>
                                <td>@race.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@race.EventLocation</td>
                                <td>@race.EventDistance km</td>
                                <td><span class="enrolment-count">—</span></td>
                                <td>
                                    <span class="status-upcoming">
                                        @(race.EventDate.Date >= DateTime.Today ? "Upcoming" : "Completed")
                                    </span>
                                </td>
                            </tr>
                        }
                        @if (ViewBag.Events.Count == 0)
                        {
                            <tr>
                                <td colspan="6">No race events are available right now.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <footer class="dashboard-footer">
            © @DateTime.Now.Year RaceDay. All rights reserved. Keep moving. Keep racing.
        </footer>
    </div>
</div>
