@model IReadOnlyList<RaceDay.MVC.Models.CategoryViewModel>
@{
    ViewData["Title"] = "Categories";
    Layout = "_Layout";
}

<div class="race-dashboard">
    <partial name="_Sidebar" />
    <div class="dashboard-main">
        <partial name="_WorkspaceMessages" />
        <header class="dashboard-header">
            <div>
                <p class="welcome-label">EVENT SETUP</p>
                <h1>Categories</h1>
                <p class="welcome-text">Create and manage categories for your events.</p>
            </div>
            <a asp-action="CreateCategory" class="dashboard-action">Create Category</a>
        </header>

        <section class="events-section">
            <div class="table-responsive">
                <table class="table events-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>CATEGORY</th>
                            <th>DISTANCE</th>
                            <th>ENTRY FEE</th>
                            <th>EVENT ID</th>
                            <th>ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td>@category.CategoryId</td>
                                <td class="event-name">@category.CategoryName</td>
                                <td>@category.CategoryDistance km</td>
                                <td>@category.EntryFee.ToString("C")</td>
                                <td>@category.EventId</td>
                                <td>
                                    <div class="workspace-actions">
                                        <a asp-action="EditCategory"
                                           asp-route-id="@category.CategoryId"
                                           class="workspace-link">Edit</a>
                                        <form asp-action="DeleteCategory"
                                              asp-route-id="@category.CategoryId"
                                              method="post"
                                              onsubmit="return confirm('Delete this category?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="workspace-danger">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="6">No categories have been created yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
