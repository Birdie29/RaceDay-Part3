@model RaceDay.MVC.Models.ParticipantProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "_Layout";
}

<div class="race-dashboard">
    <partial name="_Sidebar" />
    <div class="dashboard-main">
        <partial name="_WorkspaceMessages" />
        <header class="dashboard-header">
            <div>
                <p class="welcome-label">ACCOUNT</p>
                <h1>My Profile</h1>
                <p class="welcome-text">View and update your participant details.</p>
            </div>
        </header>

        <section class="events-section workspace-form-card">
            <form asp-action="Profile" method="post" class="workspace-form">
                @Html.AntiForgeryToken()
                <input asp-for="ParticipantId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="account-validation" role="alert"></div>

                <div class="workspace-form-grid">
                    <div class="account-field">
                        <label asp-for="Name" class="form-label">First name</label>
                        <input asp-for="Name" class="form-control" autocomplete="given-name" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="account-field">
                        <label asp-for="Surname" class="form-label">Surname</label>
                        <input asp-for="Surname" class="form-control" autocomplete="family-name" required />
                        <span asp-validation-for="Surname" class="text-danger"></span>
                    </div>
                    <div class="account-field">
                        <label asp-for="Email" class="form-label">Email address</label>
                        <input asp-for="Email" type="email" class="form-control" autocomplete="email" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="account-field">
                        <label asp-for="PhoneNumber" class="form-label">Phone number</label>
                        <input asp-for="PhoneNumber" type="tel" class="form-control" autocomplete="tel" required />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="account-field workspace-form-wide">
                        <label asp-for="NewPassword" class="form-label">New password (optional)</label>
                        <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                        <small class="form-text text-muted">Leave blank to keep your current password.</small>
                    </div>
                </div>

                <div class="workspace-form-actions">
                    <button type="submit" class="dashboard-action">Save Profile</button>
                    <a asp-action="Dashboard" class="workspace-link">Cancel</a>
                </div>
            </form>
        </section>
    </div>
</div>
