@model IReadOnlyList<RaceDay.MVC.Models.ParticipantCategoryListItemViewModel>
@{
    ViewData["Title"] = "View Categories";
    Layout = "_Layout";
}

<div class="race-dashboard">
    <partial name="_Sidebar" />
    <div class="dashboard-main">
        <partial name="_WorkspaceMessages" />
        <header class="dashboard-header">
            <div>
                <p class="welcome-label">RACE CATEGORIES</p>
                <h1>View Categories</h1>
                <p class="welcome-text">Compare distances and entry fees before registering.</p>
            </div>
        </header>

        <section class="events-section">
            <div class="table-responsive">
                <table class="table events-table">
                    <thead>
                        <tr><th>CATEGORY</th><th>EVENT</th><th>DATE</th><th>DISTANCE</th><th>ENTRY FEE</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="event-name">@item.Category.CategoryName</td>
                                <td>@(item.Event?.EventName ?? "Event unavailable")</td>
                                <td>@(item.Event?.EventDate.ToString("dd MMM yyyy") ?? "N/A")</td>
                                <td>@item.Category.CategoryDistance km</td>
                                <td>@item.Category.EntryFee.ToString("C")</td>
                                <td>
                                    @if (item.Event != null)
                                    {
                                        <a asp-action="CreateRegistration"
                                           asp-route-eventId="@item.Event.EventId"
                                           asp-route-categoryId="@item.Category.CategoryId"
                                           class="dashboard-action">Register</a>
                                    }
                                </td>
                            </tr>
                        }
                        @if (Model.Count == 0)
                        {
                            <tr><td colspan="6">There are no categories to display.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
