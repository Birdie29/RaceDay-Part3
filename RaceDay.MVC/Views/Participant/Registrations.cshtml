@model IReadOnlyList<RaceDay.MVC.Models.ParticipantRegistrationSummaryViewModel>
@{
    ViewData["Title"] = "My Registrations";
    Layout = "_Layout";
}

<div class="race-dashboard">
    <partial name="_Sidebar" />
    <div class="dashboard-main">
        <partial name="_WorkspaceMessages" />
        <header class="dashboard-header">
            <div>
                <p class="welcome-label">YOUR RACES</p>
                <h1>My Registrations</h1>
                <p class="welcome-text">Review the events and categories you have registered for.</p>
            </div>
            <a asp-action="Events" class="dashboard-action">Browse Events</a>
        </header>

        <section class="events-section">
            <div class="table-responsive">
                <table class="table events-table">
                    <thead>
                        <tr><th>EVENT</th><th>RACE DATE</th><th>CATEGORY</th><th>REGISTERED ON</th><th>CHANNEL</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var registration in Model)
                        {
                            <tr>
                                <td class="event-name">@registration.EventName</td>
                                <td>@registration.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@registration.CategoryName</td>
                                <td>@registration.RegistrationDate.ToString("dd MMM yyyy")</td>
                                <td>@registration.RegistrationChannel</td>
                            </tr>
                        }
                        @if (Model.Count == 0)
                        {
                            <tr><td colspan="5">You have not registered for an event yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
