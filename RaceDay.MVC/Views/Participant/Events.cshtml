@model IReadOnlyList<RaceDay.MVC.Models.RaceEventViewModel>
@{
    ViewData["Title"] = "View Events";
    Layout = "_Layout";
}

<div class="race-dashboard">
    <partial name="_Sidebar" />
    <div class="dashboard-main">
        <partial name="_WorkspaceMessages" />
        <header class="dashboard-header">
            <div>
                <p class="welcome-label">RACE CALENDAR</p>
                <h1>View Events</h1>
                <p class="welcome-text">Browse races and open an event to see its categories.</p>
            </div>
        </header>

        <section class="events-section">
            <div class="table-responsive">
                <table class="table events-table">
                    <thead>
                        <tr>
                            <th>EVENT</th>
                            <th>DATE</th>
                            <th>LOCATION</th>
                            <th>DISTANCE</th>
                            <th>TYPE</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var raceEvent in Model.OrderBy(raceEvent => raceEvent.EventDate))
                        {
                            <tr>
                                <td class="event-name">@raceEvent.EventName</td>
                                <td>@raceEvent.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@raceEvent.EventLocation</td>
                                <td>@raceEvent.EventDistance km</td>
                                <td>@raceEvent.EventType</td>
                                <td>
                                    <a asp-action="EventDetails"
                                       asp-route-id="@raceEvent.EventId"
                                       class="workspace-link">View event</a>
                                </td>
                            </tr>
                        }
                        @if (Model.Count == 0)
                        {
                            <tr><td colspan="6">There are no events to display.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
