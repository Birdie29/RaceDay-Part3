@if (ViewBag.ApiError is string apiError)
{
    <div class="alert alert-warning" role="alert">@apiError</div>
}
@if (TempData["WorkspaceMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}
@if (TempData["WorkspaceError"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
