@model IReadOnlyList<RaceDay.MVC.Models.RaceEventViewModel>
@{
    var recentRegistrations =
        ViewBag.RecentRegistrations as IReadOnlyList<RaceDay.MVC.Models.ParticipantRegistrationSummaryViewModel>
        ?? [];
    ViewData["Title"] = "Participant Dashboard";
    Layout = "_Layout";
}

<div class="race-dashboard">
    <partial name="_Sidebar" />
    <div class="dashboard-main">
        <partial name="_WorkspaceMessages" />

        <header class="dashboard-header">
            <div>
                <p class="welcome-label">PARTICIPANT PORTAL</p>
                <h1>Welcome, @ViewBag.UserName!</h1>
                <p class="welcome-text">
                    Explore races, choose a category, and keep track of your registrations.
                </p>
            </div>
            <div class="header-date">@DateTime.Today.ToString("dddd, dd MMMM yyyy")</div>
        </header>

        <section class="participant-banner">
            <div>
                <p class="banner-label">YOUR NEXT ADVENTURE STARTS HERE.</p>
                <h2>Push Your Limits.<br />Achieve Your Goals.</h2>
                <p>Discover exciting races and find your next finish line.</p>
                <a asp-action="Events" class="explore-button">Explore Events</a>
            </div>
            <div class="banner-decoration" aria-hidden="true"></div>
        </section>

        <section class="stats-grid" aria-label="Participant statistics">
            <div class="stat-card">
                <div class="stat-top"><span>My Registrations</span><span class="stat-icon green-icon"></span></div>
                <h2>@ViewBag.TotalRegistrations</h2>
                <p>Events you have joined</p>
            </div>
            <div class="stat-card">
                <div class="stat-top"><span>Upcoming Races</span><span class="stat-icon light-icon"></span></div>
                <h2>@ViewBag.UpcomingRegistrations</h2>
                <p>Registered events ahead</p>
            </div>
            <div class="stat-card">
                <div class="stat-top"><span>Completed Races</span><span class="stat-icon yellow-icon"></span></div>
                <h2>@ViewBag.CompletedRegistrations</h2>
                <p>Registered events in the past</p>
            </div>
            <div class="stat-card">
                <div class="stat-top"><span>Available Events</span><span class="stat-icon dark-icon"></span></div>
                <h2>@ViewBag.AvailableEvents</h2>
                <p>Upcoming events to explore</p>
            </div>
        </section>

        <section class="events-section">
            <div class="section-heading">
                <div>
                    <h3>Upcoming Events</h3>
                    <p>Find your next running challenge.</p>
                </div>
                <a asp-action="Events" class="view-all">Browse All</a>
            </div>

            <div class="participant-event-grid">
                @if (Model.Count == 0)
                {
                    <p>No race events are available right now.</p>
                }
                @foreach (var raceEvent in Model
                    .Where(raceEvent => raceEvent.EventDate.Date >= DateTime.Today)
                    .OrderBy(raceEvent => raceEvent.EventDate)
                    .Take(3))
                {
                    <article class="participant-event-card">
                        <div class="event-image">
                            <span>@($"{raceEvent.EventDistance:0.##} km")</span>
                        </div>
                        <div class="participant-event-info">
                            <span class="event-category">@raceEvent.EventType</span>
                            <h4>@raceEvent.EventName</h4>
                            <p>@raceEvent.EventLocation</p>
                            <p>@raceEvent.EventDate.ToString("dd MMMM yyyy")</p>
                            <div class="event-card-footer">
                                <span class="status-upcoming">Upcoming</span>
                                <a asp-action="EventDetails"
                                   asp-route-id="@raceEvent.EventId"
                                   class="event-link">View event</a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>

        <section class="events-section enrolments-section">
            <div class="section-heading">
                <div>
                    <h3>My Recent Registrations</h3>
                    <p>Keep track of the races you have joined.</p>
                </div>
                <a asp-action="Registrations" class="view-all">View All</a>
            </div>

            <div class="table-responsive">
                <table class="table events-table">
                    <thead>
                        <tr>
                            <th>EVENT</th>
                            <th>RACE DATE</th>
                            <th>CATEGORY</th>
                            <th>REGISTERED</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var registration in recentRegistrations)
                        {
                            <tr>
                                <td class="event-name">@registration.EventName</td>
                                <td>@registration.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@registration.CategoryName</td>
                                <td>@registration.RegistrationDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                        @if (recentRegistrations.Count == 0)
                        {
                            <tr>
                                <td colspan="4">You have not registered for an event yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <footer class="dashboard-footer">
            &copy; @DateTime.Now.Year RaceDay. Keep moving. Keep racing.
        </footer>
    </div>
</div>
