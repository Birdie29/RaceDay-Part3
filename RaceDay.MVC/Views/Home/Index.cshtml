@{
    ViewData["Title"] = "Welcome to RaceDay";
}

<div class="welcome-page">
    <section class="intro-section">
        <h1>RaceDay</h1>
        <p>See you at the finish line.</p>
    </section>

    <section class="role-section">
        <h2>Choose your role</h2>

        <div class="role-container">
            <div class="role-card" data-role="Participant">
                <div class="role-icon">
                    <i class="bi bi-person-walking"></i>
                </div>
                <h3>Participant</h3>
                <p>Be fast or be last.</p>
            </div>

            <div class="role-card"  data-role="Organiser">
                <div class="role-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <h3>Organiser</h3>
                <p>This is a lot of work for a free banana.</p>
            </div>
        </div>
    </section>

    <section class="account-section">
        <h2>Let's get started.</h2>
        <p>Choose your profile please.</p>
        <button type="button" id="registerBtn">Register</button>
        <button type="button" id="loginBtn">Login</button>
    </section>
</div>

